#!/usr/bin/env bash
# Print only the named top-level sections of a cairn/docs markdown file.
#
# Reading all of ARCHITECTURE.md costs ~15k tokens. No agent needs all of it:
# the builder needs §2 and §4, the breaker §2 §5 §6, the architect §1. Pulling
# just those sections is the difference between an 8k-token start and a 16k one,
# on every fresh agent run.
#
#   cairn/tools/doc-section ARCHITECTURE 2 4      # domain model + Phase 1 client
#   cairn/tools/doc-section ARCHITECTURE          # list the sections and their sizes
#
# Matches on heading text, not line numbers, so it survives edits to the doc.
set -euo pipefail

doc="${1:?usage: doc-section <DOC> [section-number ...]}"; shift || true
dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../docs" && pwd)"
file="$dir/${doc%.md}.md"
[ -f "$file" ] || { echo "no such doc: $file" >&2; exit 1; }

if [ $# -eq 0 ]; then
  echo "# sections of ${doc%.md}.md — pass the numbers you need"
  awk '
    /^## [0-9]+\./ { if(h){printf "  %-56s ~%dk tokens\n", h, int(c/4000+0.5)} h=$0; c=0; next }
    { c+=length($0)+1 }
    END { if(h) printf "  %-56s ~%dk tokens\n", h, int(c/4000+0.5) }
  ' "$file"
  exit 0
fi

for n in "$@"; do
  awk -v n="$n" '
    $0 ~ "^## " n "\\." { p=1 }
    p && /^## / && $0 !~ "^## " n "\\." && seen { exit }
    p { print; seen=1 }
  ' "$file"
  echo
done
