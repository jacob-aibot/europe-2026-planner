{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    // A-80 Part 6 (QA R58-3). `HIDDEN_DOOR_CENSUS` and `DESCENT_CENSUS` in
    // `packages/core/test/storable.test.ts` are template-literal types whose whole purpose is to
    // NAME every offending export or type constructor. Without this, `tsc` truncates the union and
    // prints two names and `… 8 more …`, which defeats A-79 Part 6's entire justification for that
    // form. Do not remove it without reading A-80 Part 6.
    "noErrorTruncation": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  // apps/web is NOT here on purpose. core, client, the tests and the CLI must typecheck as
  // Node ESM under NodeNext — that is the property that lets `node --test` run the .ts files
  // with no build step. apps/web is bundler-resolved with JSX and has its own tsconfig;
  // sharing one config would mean weakening this one to accommodate it.
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "test/**/*.ts", "cli.ts", "tools/**/*.ts"]
}
