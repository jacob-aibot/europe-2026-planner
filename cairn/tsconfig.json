{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  // apps/web is NOT here on purpose. core, client, the tests and the CLI must typecheck as
  // Node ESM under NodeNext — that is the property that lets `node --test` run the .ts files
  // with no build step. apps/web is bundler-resolved with JSX and has its own tsconfig;
  // sharing one config would mean weakening this one to accommodate it.
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "cli.ts", "tools/**/*.ts"]
}
